@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const comparisonData = @json($comparisonData);
    const metrics = ['oil_rate_avg','water_rate_avg','gas_rate_avg','total_gor_avg','bsw_avg','wlr_avg','gvf_avg','wlr_formula','gor_formula','bsw_formula','gvf_formula'];

    /* ===== Charts ===== */
    comparisonData.forEach(test => {
        const ctx = document.getElementById('chart-'+test.id);
        if (!ctx) return;

        const rows = test.test_data.rows ?? [];

        // Apply water metric corrections for chart data
        const oilData = rows.map(r => {
            const value = parseFloat(r['qo_lc[bbl/d]']) || 0;
            return isNaN(value) ? 0 : value;
        });

        const waterData = rows.map(r => {
            const value = parseFloat(r['qw_lc[bbl/d]']) || 0;
            // Apply negative correction for water data
            return isNaN(value) ? 0 : (value < 0 ? 0 : value);
        });

        const gasData = rows.map(r => {
            const value = parseFloat(r['qg_lc[Mcf/d]']) || 0;
            return isNaN(value) ? 0 : value;
        });

        new Chart(ctx, {
            type:'line',
            data:{
                labels: rows.map(r => r['Date & Time']),
                datasets:[
                    {label:'Oil', data: oilData, borderColor:'green'},
                    {label:'Water', data: waterData, borderColor:'blue'},
                    {label:'Gas', data: gasData, borderColor:'red'}
                ]
            },
            options:{responsive:true}
        });
    });

    /* ===== % Difference ===== */
    metrics.forEach(metric => {
        const values = comparisonData.map(t => {
            const val = t.metrics[metric];
            return (typeof val === 'string' && val !== 'N/A') ? parseFloat(val) || 0 : (typeof val === 'number' ? val : 0);
        });
        const avg = values.reduce((a,b)=>a+b,0)/values.length;

        comparisonData.forEach(test => {
            const rawValue = test.metrics[metric];
            const value = (typeof rawValue === 'string' && rawValue !== 'N/A') ? parseFloat(rawValue) || 0 : (typeof rawValue === 'number' ? rawValue : 0);
            const diff = avg ? ((value - avg)/avg)*100 : 0;

            const span = document.querySelector(
                `.metric-diff[data-metric="${metric}"][data-value="${rawValue}"]`
            );

            if (!span) return;

            let arrow='→', color='gray';
            if (diff > 2) { arrow='↑'; color='green'; }
            if (diff < -2){ arrow='↓'; color='red'; }

            span.innerHTML = `<strong style="color:${color}">
                ${arrow} ${diff.toFixed(1)}%
            </strong>`;
        });
    });

});
</script>
@endpush
