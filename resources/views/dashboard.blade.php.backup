@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    @if($testsByClient->count() > 0)
    // Tests by Client Chart
    const testsByClientCtx = document.getElementById('testsByClientChart').getContext('2d');
    const testsByClientChart = new Chart(testsByClientCtx, {
        type: 'doughnut',
        data: {
            labels: @json($testsByClient->pluck('client')),
            datasets: [{
                data: @json($testsByClient->pluck('count')),
                backgroundColor: [
                    '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b',
                    '#858796', '#5a5c69', '#6777ef', '#f57850', '#6fd96f'
                ]
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
    @endif

    @if($testsOverTime->count() > 0)
    // Tests Over Time Chart
    const testsOverTimeCtx = document.getElementById('testsOverTimeChart').getContext('2d');
    const testsOverTimeChart = new Chart(testsOverTimeCtx, {
        type: 'line',
        data: {
            labels: @json($testsOverTime->pluck('date')),
            datasets: [{
                label: 'Tests Count',
                data: @json($testsOverTime->pluck('count')),
                borderColor: '#4e73df',
                backgroundColor: 'rgba(78, 115, 223, 0.1)',
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
    @endif
</script>
@endpush
