                    <thead>
                        <tr>
                            @foreach($parsed_data['test_data']['columns'] as $col)
                                <th style="min-width: 150px;">{{ $col }}</th>
                            @endforeach
                        </tr>
                    </thead>
                    <tbody>
                        @foreach($parsed_data['test_data']['rows'] as $row)
                        <tr>
                            @foreach($parsed_data['test_data']['columns'] as $col)
                                @php
                                    $value = $row[$col] ?? '';
                                    $class = '';
                                    if (is_numeric($value)) {
                                        if (stripos($col, 'WHP') !== false && $value < 400) $class = 'table-danger';
                                        if (stripos($col, 'Temp') !== false && $value > 200) $class = 'table-warning';
                                        if (stripos($col, 'Press') !== false && $value < 200) $class = 'table-danger';
                                        if (stripos($col, 'Voltage') !== false && ($value < 100 || $value > 250)) $class = 'table-warning';
                                    }
                                @endphp
                                <td class="{{ $class }}" style="min-width: 150px;">{{ $value }}</td>
                            @endforeach
                        </tr>
                        @endforeach
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
@endsection

@section('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const ratesData = @json($rates_chart_data);
    const gorData = @json($gor_chart_data);

    // --- Production Rates Chart ---
    const ratesCtx = document.getElementById('ratesChart');
    if (ratesCtx && ratesData.labels && ratesData.datasets) {
        new Chart(ratesCtx.getContext('2d'), {
            type: 'line',
            data: ratesData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: { display: true, text: 'Production Rates vs Time' },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    x: { title: { display: true, text: 'Time (HH:MM)' } },
                    y: { beginAtZero: true, title: { display: true, text: 'Rate' } }
                }
            }
        });
    }

    // --- GOR Chart ---
    const gorCtx = document.getElementById('gorChart');
    if (gorCtx && gorData.labels && gorData.datasets) {
        new Chart(gorCtx.getContext('2d'), {
            type: 'line',
            data: gorData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: { display: true, text: 'GOR vs Time' },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    x: { title: { display: true, text: 'Time (HH:MM)' } },
                    y: { beginAtZero: true, title: { display: true, text: 'GOR (Scf/STB)' } }
                }
            }
        });
    }

    // --- Initialize DataTable ---
    const detailTable = document.getElementById('vxDetailTable');
    if (detailTable) {
        $('#vxDetailTable').DataTable({
            scrollX: true,
            pageLength: 25,
            lengthMenu: [ [10, 25, 50, 100, -1], [10, 25, 50, 100, "All"] ]
        });
    }
});
</script>
@endsection